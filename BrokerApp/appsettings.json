{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Broker": {
    "Port": 5000,
    "AckTimeoutSeconds": 5,
    "MaxRetries": 3,
    "RetryIntervalMs": 1000,
    "SessionExpiryMinutes": 10,
    "FaultInjection": {
      "Enabled": true,
      "LoseResponseKeyword": "#lose-response",
      "LostResponseProbability": 0.0,
      "Mode": "Delay",
      "DelayMs": 5000
    }
  }
}